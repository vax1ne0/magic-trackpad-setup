<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Magic Trackpad Setup for Windows" Manufacturer="Magic Trackpad Setup contributors" Version="1.2.0" UpgradeCode="ACA09550-4B7C-4FAA-B061-A2510EE94CEF" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Magic Trackpad Setup is already installed." />
    <MediaTemplate EmbedCab="yes"/>
    <Property Id="REALBUILD"><RegistrySearch Id="ReadBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64"/></Property>
    <Launch Condition="Installed OR (VersionNT64 AND REALBUILD &gt;= 22000 AND NOT Arm64)" Message="Magic Trackpad Setup needs Windows 11 on an Intel or AMD x64 PC." />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/vax1ne0/magic-trackpad-setup"/>
    <Property Id="ARPPRODUCTICON" Value="AppIcon"/>
    <Icon Id="AppIcon" SourceFile="src/TrackpadBattery.ico"/>
    <ui:WixUI Id="WixUI_Minimal"/>
    <WixVariable Id="WixUILicenseRtf" Value="installer/License.rtf"/>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Magic Trackpad Setup">
        <Component Id="Hub" Guid="*">
          <File Id="HubExe" Source="src/MagicTrackpadSetup.exe" KeyPath="yes"/>
          <Shortcut Id="AppLink" Directory="ProgramMenuFolder" Name="Magic Trackpad" Target="[#HubExe]" WorkingDirectory="INSTALLFOLDER" Description="Magic Trackpad settings and battery"/>
          <RemoveFolder Id="RemoveInstallFolder" On="uninstall"/>
        </Component>
        <Component Id="Battery" Guid="*"><File Id="BatteryExe" Source="src/TrackpadBattery.exe" KeyPath="yes"/></Component>
        <Component Id="PanelIcon" Guid="*"><File Source="src/TrackpadBattery.ico" Name="MagicTrackpad.ico"/></Component><Component Id="ControlPanel" Guid="*"><File Id="PanelExe" Source="payload/TrackpadControlPanel.exe"/></Component>
        <Directory Id="DRIVERDIR" Name="Driver">
          <Component Id="DriverInf" Guid="*"><File Source="payload/AmtPtpDevice.inf"/></Component>
          <Component Id="DriverCat" Guid="*"><File Source="payload/amtptpdevice.cat"/></Component>
          <Component Id="DriverDll" Guid="*"><File Source="payload/AmtPtpDeviceUsbUm.dll"/></Component>
          <Component Id="DriverSys" Guid="*"><File Source="payload/AmtPtpHidFilter.sys"/></Component>
        </Directory>
        <Directory Id="LEGALDIR" Name="ThirdParty">
          <Component Id="PanelSource" Guid="*"><File Source="payload/PanelSource.zip"/></Component><Component Id="UpstreamSource" Guid="*"><File Source="payload/UpstreamSource.zip"/></Component>
          <Component Id="UpstreamLicense" Guid="*"><File Source="payload/UpstreamLicense.txt"/></Component>
        </Directory>
        <Directory Id="BATTSTATE" Name="BatteryData">
          <Component Id="State" Guid="645E85DB-3486-4F87-99BD-58155E473EA1"><CreateFolder/><RemoveFile Id="ClearState" Name="status.txt" On="uninstall"/><RemoveFile Id="ClearDischarge" Name="discharge.csv" On="uninstall"/><RemoveFile Id="ClearPending" Name="discharge.csv.tmp" On="uninstall"/><RemoveFolder Id="RemoveState" On="uninstall"/></Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"/>
    <CustomAction Id="RemoveAutostart" FileRef="BatteryExe" ExeCommand="--remove-autostart" Execute="deferred" Impersonate="no" Return="check"/>
    <CustomAction Id="InstallDriver" FileRef="HubExe" ExeCommand="--install-driver" Execute="deferred" Impersonate="no" Return="check"/>
    <CustomAction Id="StartMonitor" FileRef="HubExe" ExeCommand="--start-monitor [UserSID]" Execute="commit" Impersonate="no" Return="check"/>
    <InstallExecuteSequence>
      <Custom Action="InstallDriver" After="InstallFiles" Condition="NOT REMOVE"/>
      <Custom Action="StartMonitor" After="InstallDriver" Condition="NOT Installed"/><Custom Action="RemoveAutostart" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/></InstallExecuteSequence>
    <Feature Id="Main" Title="Magic Trackpad Setup" Level="1"><ComponentRef Id="Hub"/><ComponentRef Id="Battery"/><ComponentRef Id="State"/><ComponentRef Id="ControlPanel"/><ComponentRef Id="PanelIcon"/><ComponentRef Id="DriverInf"/><ComponentRef Id="DriverCat"/><ComponentRef Id="DriverDll"/><ComponentRef Id="DriverSys"/><ComponentRef Id="UpstreamSource"/><ComponentRef Id="PanelSource"/><ComponentRef Id="UpstreamLicense"/></Feature>
  </Package>
</Wix>


