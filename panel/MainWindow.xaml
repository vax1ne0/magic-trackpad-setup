<Window xmlns:local="using:AmtPtpControlPanel.WinUI3" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="AmtPtpControlPanel.WinUI3.MainWindow" mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <SolidColorBrush x:Key="ExpanderChevronPointerOverBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="ExpanderChevronBorderPointerOverBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="ExpanderChevronPressedBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="ExpanderChevronBorderPressedBrush" Color="Transparent"/>
            <DataTemplate x:Key="ReleaseNotesTemplate">
                <Border Padding="14,12" CornerRadius="6" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <ItemsControl ItemsSource="{Binding}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="•" AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </DataTemplate>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="20"/>
            </Style>

            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <Style x:Key="SettingsIconTileStyle" TargetType="Border">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header (also used as the custom draggable title bar) -->
        <StackPanel x:Name="HeaderPanel" Grid.Row="0" Padding="28,40,28,6" Spacing="4">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" Text="Magic Trackpad" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Settings -->
        <Grid Grid.Row="1" Padding="28,0" RowSpacing="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid>
          <SelectorBar x:Name="Pages" SelectionChanged="PageChanged" Margin="-12,0,0,0">
            <SelectorBar.Resources>
              <SolidColorBrush x:Key="SelectorBarItemPillFill" Color="Transparent"/>
            </SelectorBar.Resources>
            <SelectorBarItem x:Name="SettingsTab" Text="Trackpad" IsSelected="True"/>
            <SelectorBarItem x:Name="KeyboardTab" Text="Keyboard"/>
          </SelectorBar>
          <Canvas x:Name="TabIndicatorLayer" FlowDirection="LeftToRight" IsHitTestVisible="False" LayoutUpdated="TabLayoutUpdated">
            <Border x:Name="TabIndicator" Width="16" Height="3" CornerRadius="1.5" Opacity="0"
                    Background="{ThemeResource AccentFillColorDefaultBrush}" AutomationProperties.AccessibilityView="Raw">
              <Border.RenderTransform><CompositeTransform x:Name="TabMotion" CenterX="8"/></Border.RenderTransform>
            </Border>
          </Canvas>
          </Grid>
        <ScrollViewer x:Name="TrackpadPage" Grid.Row="1" Padding="0,2,0,10" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">

                <!-- Battery -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Style="{StaticResource SettingsIconTileStyle}">
                                <FontIcon x:Name="BatteryIcon" Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="BatteryTitle" Margin="0" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" Text="Battery" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="8" VerticalAlignment="Center">
                                <ProgressBar x:Name="BatteryProgressBar" Height="16" Maximum="100" Minimum="0" Value="0"/>
                                <TextBlock x:Name="BatteryStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"/>
                            </StackPanel>

                            <Button x:Name="UpdateBatteryButton" Grid.Column="1" VerticalAlignment="Center" Click="UpdateBatteryButton_Click" Content="Update Battery"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <local:SectionExpander x:Name="ClickSection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False" Expanding="Section_Expanding">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8,0,8">
                                <Border Style="{StaticResource SettingsIconTileStyle}">
                                    <FontIcon Glyph="" FontSize="20" FontFamily="Segoe MDL2 Assets"/></Border>
                                <TextBlock x:Name="ClickFeedbackTitle" Margin="0" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" Text="MacOS click options" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="12">

                        <RadioButton x:Name="MacOSClickOptions" Content="Use macOS Click Options:" Checked="ClickOptions_Checked"/>

                        <StackPanel x:Name="MacOSOptionsPanel" Padding="28,0,0,0" Orientation="Vertical" Spacing="8" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="ClickStrengthLabel" Style="{StaticResource BodyTextBlockStyle}" Text="Click strength" TextWrapping="Wrap"/>

                                <Slider x:Name="FeedbackSlider" HorizontalAlignment="Stretch" Maximum="2" Minimum="0" SnapsTo="Ticks" StepFrequency="1" TickFrequency="1" Value="1"/>

                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LightLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Light" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="MediumLabel" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Medium" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="FirmLabel" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Firm" TextAlignment="Right" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>

                            <ComboBox x:Name="ReleaseStrength" Header="Release feedback" SelectedIndex="0">
                                <ComboBoxItem x:Name="ReleaseMatch"/>
                                <ComboBoxItem x:Name="ReleaseLight"/>
                                <ComboBoxItem x:Name="ReleaseMedium"/>
                                <ComboBoxItem x:Name="ReleaseFirm"/>
                            </ComboBox>
                            <CheckBox x:Name="SilentClicking" Content="Silent clicking" VerticalAlignment="Center"/>
                        </StackPanel>
                    <RadioButton x:Name="DisableFeedback" Content="Disable haptic feedback and force touch button completely" Checked="ClickOptions_Checked"/>

                        <RadioButton x:Name="MaximumFeedback" Content="Maximum haptic feedback (very clicky and loud!)" Checked="ClickOptions_Checked"/>
                    </StackPanel>
                    </local:SectionExpander>

                <local:SectionExpander x:Name="GesturesSection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Expanding="Section_Expanding">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8">
                            <Border Style="{StaticResource SettingsIconTileStyle}">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE815;" FontSize="20"/>
                            </Border>
                            <TextBlock Text="Extra gestures" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="12">
                        <ToggleSwitch x:Name="EdgeSwitch" Header="Edge sliders" Toggled="InputOptionChanged"/>
                        <TextBlock Text="In trackpad mode, slide one finger along the left edge for screen brightness or the right edge for volume. The bottom is 0% and the top is 100%." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <TextBlock x:Name="EdgeStatus" Visibility="Collapsed" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
                        <ToggleSwitch x:Name="MediaSwitch" Header="Five-finger gestures" Toggled="InputOptionChanged"/>
                        <StackPanel x:Name="GestureRows"/>
                        <TextBlock x:Name="GuardInfo" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        <HyperlinkButton Content="Three- and four-finger settings in Windows" Click="TouchpadSettingsButton_Click"/>
                        <TextBlock x:Name="MediaFeedback" AutomationProperties.LiveSetting="Polite" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </local:SectionExpander>

                <local:SectionExpander x:Name="LiftSection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False" Expanding="Section_Expanding">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8,0,8">
                                <Border Style="{StaticResource SettingsIconTileStyle}">
                                    <FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                                </Border>
                                <TextBlock x:Name="LiftFingerTitle" Margin="0" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" Text="When you lift your finger from the trackpad" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="12">

                        <RadioButton x:Name="StopDoNothing" Content="Do nothing" Checked="StopOptions_Checked"/>

                        <RadioButton x:Name="StopPressure" Checked="StopOptions_Checked">
                            <StackPanel Spacing="4"><TextBlock x:Name="StopPressureText" VerticalAlignment="Top" Text="Stop the pointer if the pressure is less than or equal to" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="10"><NumberBox x:Name="StopPressureValue" Width="110" VerticalAlignment="Center" Minimum="0" SpinButtonPlacementMode="Compact" Value="0"/>
                                    <TextBlock x:Name="StopPressureLabelText" VerticalAlignment="Center" TextWrapping="Wrap" Text="units. (0 means no pressure; 0 is a good value)"/>
                                </StackPanel></StackPanel></RadioButton>

                        <RadioButton x:Name="StopSize" Checked="StopOptions_Checked">
                            <StackPanel Spacing="4"><TextBlock x:Name="StopSizeText" VerticalAlignment="Top" Text="Stop the pointer if the size of the touch area is less than or equal to" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="10"><NumberBox x:Name="StopSizeValue" Width="110" VerticalAlignment="Center" Minimum="0" SpinButtonPlacementMode="Compact" Value="7"/>
                                    <TextBlock x:Name="StopSizeLabelText" VerticalAlignment="Center" TextWrapping="Wrap" Text="units. (7 is a good value)"/>
                                </StackPanel></StackPanel></RadioButton>
                    </StackPanel>
                    </local:SectionExpander>

                <local:SectionExpander x:Name="TouchSection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False" Expanding="Section_Expanding">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8,0,8">
                                <Border Style="{StaticResource SettingsIconTileStyle}">
                                    <FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                                </Border>
                                <TextBlock x:Name="OtherOptionsTitle" Margin="0" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" Text="Other options" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="12">

                        <CheckBox x:Name="IgnoreNearFingers" Content="Ignore input from fingers not touching the trackpad surface"/>
                        <CheckBox x:Name="PalmRejection" Content="Palm Rejection"/>

                        <CheckBox x:Name="IgnoreButtonFinger">
                            <TextBlock x:Name="IgnoreButtonFingerText" Text="Ignore input from the finger used to click the force touch button (useful for dragging, if you use your thumb to click the button and your index finger to move the pointer, for example)" TextWrapping="Wrap"/>
                        </CheckBox>

                        <CheckBox x:Name="InvertMovement">
                            <TextBlock x:Name="InvertMovementText" Text="Invert up/down and left/right (for upside-down use)" TextWrapping="Wrap"/>
                        </CheckBox>

                        <CheckBox x:Name="AllowNonAdminAccess">
                            <TextBlock x:Name="AllowNonAdminAccessText" Text="ADVANCED: Let non-admin apps communicate with the drivers" TextWrapping="Wrap"/>
                        </CheckBox>

                    </StackPanel>
                    </local:SectionExpander>

                <local:SectionExpander x:Name="AppSection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Expanding="Section_Expanding">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8">
                            <Border Style="{StaticResource SettingsIconTileStyle}"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="20"/></Border>
                            <TextBlock x:Name="AppSettingsTitle" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" Margin="0" Text="App settings"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="10">
                        <ToggleSwitch x:Name="StartupSwitch" Header="Open at startup" Toggled="Startup_Toggled"/>
                        <TextBlock x:Name="StartupHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Show the battery beside the clock when you sign in."/>
                        <CheckBox x:Name="BatteryAlert" Click="BatteryAlert_Click"/>
                        <TextBlock x:Name="LanguageLabel" Style="{StaticResource BodyTextBlockStyle}" Text="UI language" TextWrapping="Wrap"/>

                        <ComboBox x:Name="LanguageComboBox" HorizontalAlignment="Left" MinWidth="180" SelectionChanged="LanguageComboBox_SelectionChanged"/>
                        <Button x:Name="UpdateAppButton" Click="CheckUpdates_Click" Content="Check for updates"/>
                        <StackPanel Spacing="4">
                            <ProgressBar x:Name="UpdateProgressBar" Visibility="Collapsed" Width="240" HorizontalAlignment="Left" AutomationProperties.LabeledBy="{Binding ElementName=UpdateStatus}"/>
                            <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <TextBlock x:Name="TransferDetails" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                        <Border Margin="0,10,0,0" Padding="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <StackPanel Spacing="8">
                                <Button x:Name="DefaultsButton" Click="RestoreDefaults_Click"/>
                                <TextBlock x:Name="DefaultsHint" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </local:SectionExpander>
            </StackPanel>
        </ScrollViewer>

          <ScrollViewer x:Name="KeyboardPage" Grid.Row="1" Visibility="Collapsed"><StackPanel Spacing="12">
            <InfoBar x:Name="KeyboardError" Severity="Warning" IsOpen="False"/>
            <ToggleSwitch x:Name="KeyboardSwitch" Header="Sticker keyboard" Toggled="InputOptionChanged"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="•" AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Grid.Column="1" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Switch modes. "/><Run Text="Click the top-right corner to switch between typing and pointing."/></TextBlock>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="•" AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Grid.Column="1" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Point and scroll. "/><Run Text="With two-finger pointing enabled, move two fingers to use the pointer while typing. Keep them down, add a third finger, then slide up or down to scroll. Lift all fingers to resume typing."/></TextBlock>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="•" AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Grid.Column="1" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Move the overlay. "/><Run Text="Hold a click in that corner, then drag the handle. Click or hold the corner again to resume typing."/></TextBlock>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="•" AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Grid.Column="1" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Use shortcuts. "/><Run Text="Rest one finger on Shift, Ctrl, Alt, or Win and press another key."/></TextBlock>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="•" AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Grid.Column="1" TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Return to pointing. "/><Run Text="Press Ctrl+Alt+F10 on your physical keyboard."/></TextBlock>
                    </Grid>
                </StackPanel>
            </Border>
            <CheckBox x:Name="TapSwitch" Content="Tap to type" Click="InputOptionChanged"/>
            <CheckBox x:Name="CursorGesture" Content="Use two fingers to point, click, and drag in keyboard mode" Click="InputOptionChanged"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><ToggleButton x:Name="OverlayButton" Content="Floating keyboard" Click="ToggleOverlay"/><ToggleButton x:Name="PositionButton" Content="Position overlay" Visibility="Collapsed" Click="PositionOverlay"/></StackPanel>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <Slider x:Name="OverlayTransparency" Header="Transparency" Minimum="0" Maximum="90" StepFrequency="1" ValueChanged="OverlayAppearanceChanged"/>
                            <TextBlock Text="Higher makes the keyboard more see-through." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock x:Name="TransparencyValue" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                    <ToggleSwitch x:Name="FadeIdle" Header="Fade when idle" Toggled="FadeIdleChanged"/>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <Slider x:Name="IdleAmount" IsEnabled="{Binding IsOn, ElementName=FadeIdle}" Header="Idle dimming" Minimum="10" Maximum="95" StepFrequency="1" ValueChanged="IdleAppearanceChanged"/>
                            <TextBlock Text="Higher makes the keyboard more see-through when you're not using it" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock x:Name="IdleAmountValue" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <Slider x:Name="IdleDuration" IsEnabled="{Binding IsOn, ElementName=FadeIdle}" Header="Fade duration" Minimum="200" Maximum="2000" StepFrequency="50" ValueChanged="IdleAppearanceChanged"/>
                            <TextBlock Text="Higher makes idle dimming take more time to work." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock x:Name="IdleDurationValue" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <Slider x:Name="OverlayScale" Header="Scale" Minimum="50" Maximum="150" StepFrequency="1" ValueChanged="OverlayAppearanceChanged"/>
                            <TextBlock Text="Higher makes the keyboard larger." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock x:Name="ScaleValue" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Viewbox Stretch="Uniform" MaxHeight="350" HorizontalAlignment="Center" FlowDirection="LeftToRight">
                <Canvas x:Name="Sticker" Width="640" Height="459.6" IsHitTestVisible="False"/>
            </Viewbox>
            <TextBox x:Name="Practice" PlaceholderText="Try typing here" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
          </StackPanel></ScrollViewer>
        </Grid>

        <!-- Footer actions -->
        <Grid x:Name="SettingsFooter" Grid.Row="2" SizeChanged="Footer_SizeChanged" Padding="28,8,28,20" ColumnSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="HelpActions" Orientation="Horizontal" Spacing="4">
                <HyperlinkButton x:Name="GitHubLink" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Content="Project on GitHub" NavigateUri="https://github.com/vax1ne0/magic-trackpad-setup"/>
                <Button x:Name="CopyDetailsButton" Style="{StaticResource SubtleButtonStyle}" Click="CopyDetails_Click"/>
            </StackPanel>

            <Button x:Name="TouchpadSettingsButton" Grid.Column="1" Click="TouchpadSettingsButton_Click" Content="Windows Touchpad Settings"/>

            <Button x:Name="ApplyButton" Grid.Column="2" Click="ApplyButton_Click" Content="Apply" Style="{StaticResource AccentButtonStyle}"/>
        </Grid>

    </Grid>
</Window>
